{
  "name": "lalaleap-mcp-server",
  "version": "1.1.0",
  "description": "Lalaleap MCP Server - AI 工具操作 Lalaleap 專案管理系統",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "lalaleap-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --env-file-if-exists=.env --import tsx/esm src/test.ts",
    "test:mcp": "node --env-file-if-exists=.env --import tsx/esm src/test-mcp.ts",
    "test:npx": "node --env-file-if-exists=.env --import tsx/esm src/test-npx.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["mcp", "lalaleap", "project-management", "ai", "claude", "cursor"],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuraki5336/tpi_lalaleap_mcp.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "axios": "^1.13.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
