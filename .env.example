# 複製此檔為 .env 後填入自己的憑證（.env 已被 .gitignore 忽略，不會進版控）
# 測試腳本會透過 npm scripts 的 --env-file-if-exists=.env 自動載入

LALALEAP_API_URL=https://your-dev-host/ap2/lalaleap

# 認證二擇一：帳密登入，或 API Token（Token 優先）
LALALEAP_EMAIL=your-email@example.com
LALALEAP_PASSWORD=your-password
# LALALEAP_API_TOKEN=

# dev 環境憑證過期時設 1 跳過 SSL 驗證
LALALEAP_UNSAFE_SSL=1

# 選填的寫入防護
# LALALEAP_READONLY=1
# LALALEAP_ALLOWED_PROJECTS=1000001,1000002
# LALALEAP_WRITE_RATE_LIMIT=10
